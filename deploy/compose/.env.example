# Copy to .env and replace every value. .env is git-ignored.
#
# Use an immutable image reference. Prefer the exact digest recorded in
# security/registry-release-ledger.json over a movable tag.
SEVENMIRROR_IMAGE=ghcr.io/huaxianyan/sevenmirror-server@sha256:REPLACE_WITH_INDEX_DIGEST

# Host loopback address and port that the reverse proxy forwards to. Do not bind
# a wildcard or a LAN address: the relay must not be reachable except through the
# proxy on the same host.
SEVENMIRROR_RELAY_BIND=127.0.0.1:18081

# Exact source address the relay sees for reverse-proxy traffic, as a single
# IPv4 address with /32. Inspect the real Docker bridge gateway after the first
# start (`docker network inspect`) and pin that one address. Never widen this to
# a subnet: any peer inside it may then spoof the forwarded client address.
SEVENMIRROR_TRUSTED_PROXY=172.17.0.1/32

# Management console listen address. The process rejects wildcard, hostname, and
# non-loopback values, so this stays on host loopback.
SEVENMIRROR_ADMIN_ADDRESS=127.0.0.1:8081

# Exact origin the operator browser uses. Keep it identical to what the browser
# sends, including the scheme and port; an HTTPS origin must be reachable over
# HTTPS at the proxy.
SEVENMIRROR_ADMIN_ORIGIN=http://127.0.0.1:8081

# The console account is not configured here. A registry without a stored
# credential answers to the built-in default account, and the first sign-in is
# forced into the credential setup before any management route opens. See the
# credential section of docs/admin-web.md.

# on keeps the one-time recovery code that the process prints at startup, which is
# the way back in after a lost authenticator device. off removes that entry point.
SEVENMIRROR_ADMIN_RECOVERY_CODE=on

# Exact source addresses the console trusts to set X-Forwarded-For, so the login
# limiter keys on the real client instead of the reverse proxy. Leave empty only
# when the console is reached directly, never widen it to a whole subnet.
SEVENMIRROR_ADMIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32
