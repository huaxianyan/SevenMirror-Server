# Copy this file to .env and replace every value. .env is git-ignored.
#
# Persistent state stays beside this file under data/, authority/ and backups/,
# so backing up the deployment is copying this directory.

# The image to run. A tag build publishes three references to the same verified
# image, so all of these work:
#
#   ghcr.io/huaxianyan/sevenmirror-server:latest
#   ghcr.io/huaxianyan/sevenmirror-server:0.1.0          (from PROTOCOL_VERSION)
#   ghcr.io/huaxianyan/sevenmirror-server:<40-char commit>
#   ghcr.io/huaxianyan/sevenmirror-server@sha256:<index digest>
#
# Pin a digest before exposing the relay to real traffic. The digest is the only
# identity that cannot move, so it is the one that answers "which revision is
# running". Following `latest` with an automated updater gives that up; see the
# "Following a moveable tag" section of docs/registry-release-governance.md.
SEVENMIRROR_IMAGE=ghcr.io/huaxianyan/sevenmirror-server@sha256:REPLACE_WITH_INDEX_DIGEST

# Host loopback address and port that your reverse proxy forwards to. Do not bind
# a wildcard or a LAN address: the relay must not be reachable except through the
# proxy on the same host. The relay container shares the host network namespace,
# so this address is bound directly on the host.
SEVENMIRROR_RELAY_BIND=127.0.0.1:18081

# Source address the relay sees for reverse-proxy traffic, as one IPv4 address
# with /32. Your reverse proxy connects over loopback, so the default is already
# correct and does not need to be looked up.
#
# Only change this if you deliberately put the proxy somewhere else. Never widen
# it to a subnet: any peer inside it could then spoof the forwarded client
# address, and rate limiting would key on the wrong thing.
SEVENMIRROR_TRUSTED_PROXY=127.0.0.1/32

# Management console listen address. The process rejects wildcard, hostname and
# non-loopback values, so this stays on host loopback. The console is not exposed
# publicly; reach it through an SSH tunnel.
SEVENMIRROR_ADMIN_ADDRESS=127.0.0.1:8081

# Exact origin your browser uses for the console. Keep it identical to what the
# browser sends, including the scheme and port. The default matches the SSH tunnel
# form documented in docs/deployment.md.
SEVENMIRROR_ADMIN_ORIGIN=http://127.0.0.1:8081

# The console account is not configured here. A registry without a stored
# credential answers to the built-in default account, and the first sign-in is
# forced into the credential setup before any management route opens. See the
# credential section of docs/admin-web.md.

# on keeps the one-time recovery code the process prints at startup, which is the
# way back in after a lost authenticator device. off removes that entry point.
SEVENMIRROR_ADMIN_RECOVERY_CODE=on

# Source addresses the console trusts to set X-Forwarded-For, so the login limiter
# keys on the real client instead of the tunnel. Leave it at loopback unless you
# reach the console another way, and never widen it to a whole subnet.
SEVENMIRROR_ADMIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32
